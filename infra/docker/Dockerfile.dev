# Dev image shared by web, api, mock-kora, migrate.
FROM node:22-alpine

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    CHOKIDAR_USEPOLLING=1
RUN corepack enable && apk add --no-cache libc6-compat wget

WORKDIR /app

# Install deps with only manifests copied, so the layer caches until a lockfile changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/mock-kora/package.json apps/mock-kora/
COPY packages/ packages/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Source is bind-mounted by docker-compose at runtime.
