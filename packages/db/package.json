{
  "name": "@switchboard/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@switchboard/env": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@switchboard/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
